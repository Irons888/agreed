{
  "name": "agreed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && vite",
    "build": "node scripts/prepare-public.mjs && npm run build-storybook && vite build && node scripts/copy-storybook.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "cf-types": "wrangler types",
    "eval": "node eval/run.mjs",
    "testset:build": "node testset/build.mjs",
    "testset:voices": "node testset/build.mjs --list-voices",
    "storybook": "node scripts/prepare-public.mjs && storybook dev -p 6006 --no-open",
    "build-storybook": "STORYBOOK_FOR_DEPLOY=1 storybook build -o storybook-static --quiet"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
